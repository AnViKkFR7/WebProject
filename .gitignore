# Dependencies
node_modules/

# Build output
dist/

# Environment files
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# SQL
# El esquema y las migraciones SÍ van a git: son la única copia de cómo está
# montada la base de datos. Lo que nunca debe subirse es un .sql con valores
# reales (claves, tokens): esas copias van en database/local/.
database/local/*
!database/local/.gitkeep
*.local.sql
*.secret.sql
